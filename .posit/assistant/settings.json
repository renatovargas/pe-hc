{
  "sandbox": {
    "enabled": true
  },
  "permission": {
    "edit": {
      "*.qmd": "allow",
      "*.R": "allow",
      "*.bib": "allow"
    },
    "bash": {
      "cd *": "allow",
      "Rscript *": "allow",
      "tail *": "allow",
      "head *": "allow",
      "sed *": "allow",
      "grep *": "allow",
      "pdftoppm *": "allow",
      "ls *": "allow"
    },
    "executeCode": {
      "*": "allow"
    }
  }
}